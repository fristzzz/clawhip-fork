# clawhip 环境变量配置
# =====================
# 复制此文件为 .env 并填入实际值
# 重要: .env 文件已被 .gitignore 忽略，不会推送到远程仓库

# Discord 配置
DISCORD_TOKEN=
CLAWHIP_DISCORD_BOT_TOKEN=

# GitHub 配置 (用于监控 issues/PR)
CLAWHIP_GITHUB_TOKEN=

# 飞书配置
CLAWHIP_FEISHU_ROBOT_ID=

# Daemon 配置 (可选)
# CLAWHIP_DAEMON_URL=http://127.0.0.1:25294
